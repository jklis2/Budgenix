generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  password          String
  isActive          Boolean        @default(false)
  activationToken   String?
  twoFACode         String?
  twoFAExpiry       DateTime?
  rememberMe        Boolean        @default(false)
  failedAttempts    Int            @default(0)
  lastFailedAttempt DateTime?
  firstName         String?
  lastName          String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  accounts          Account[]
  budgets           Budget[]
  categories        Category[]
  savingsGoals      SavingsGoal[]
  subscriptions     Subscription[]
  transactions      Transaction[]
}

model Account {
  id           String                   @id @default(uuid())
  name         String
  balance      Float
  accountType  String
  currency     String                   @default("PLN")
  isDefault    Boolean                  @default(false)
  userId       String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  user         User                     @relation(fields: [userId], references: [id], onUpdate: NoAction)
  transactions Transaction[]
  contributions SavingsGoalContribution[]
  subscriptions Subscription[]
}

model Category {
  id            String         @id @default(uuid())
  name          String
  icon          String
  color         String
  isIncome      Boolean        @default(false)
  isDefault     Boolean        @default(false)
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  budgetItems   BudgetItem[]
  user          User           @relation(fields: [userId], references: [id], onUpdate: NoAction)
  subscriptions Subscription[]
  transactions  Transaction[]
}

model Transaction {
  id            String   @id @default(uuid())
  title         String
  amount        Float
  date          DateTime
  notes         String?
  paymentMethod String
  isRecurring   Boolean  @default(false)
  categoryId    String
  accountId     String
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  account       Account  @relation(fields: [accountId], references: [id], onUpdate: NoAction)
  category      Category @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  user          User     @relation(fields: [userId], references: [id], onUpdate: NoAction)
}

model Budget {
  id          String       @id @default(uuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  totalAmount Float
  isActive    Boolean      @default(true)
  userId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onUpdate: NoAction)
  budgetItems BudgetItem[]
}

model BudgetItem {
  id              String   @id @default(uuid())
  allocatedAmount Float
  budgetId        String
  categoryId      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  budget          Budget   @relation(fields: [budgetId], references: [id], onUpdate: NoAction)
  category        Category @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
}

model SavingsGoal {
  id            String                   @id @default(uuid())
  name          String
  targetAmount  Float
  currentAmount Float                    @default(0)
  startDate     DateTime
  targetDate    DateTime
  isCompleted   Boolean                  @default(false)
  icon          String?
  color         String?
  userId        String
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  user          User                     @relation(fields: [userId], references: [id], onUpdate: NoAction)
  contributions SavingsGoalContribution[]
}

model Subscription {
  id              String    @id @default(uuid())
  name            String
  amount          Float
  billingCycle    String
  startDate       DateTime
  nextBillingDate DateTime
  categoryId      String?
  accountId       String?
  userId          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account         Account?  @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user            User      @relation(fields: [userId], references: [id], onUpdate: NoAction)
}

model SavingsGoalContribution {
  id            String      @id @default(uuid())
  amount        Float
  date          DateTime
  accountId     String
  savingsGoalId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  account       Account     @relation(fields: [accountId], references: [id], onUpdate: NoAction)
  savingsGoal   SavingsGoal @relation(fields: [savingsGoalId], references: [id], onUpdate: NoAction)
}
